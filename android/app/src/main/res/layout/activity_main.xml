<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="#FDFBF7">
 <LinearLayout android:id="@+id/main_col" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FDFBF7">
  <LinearLayout android:id="@+id/header_bar" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:elevation="4dp">
   <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="4dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/logo_circle" android:src="@drawable/ic_logo_light" android:padding="5dp" android:contentDescription="LuxeParlour logo" android:layout_width="36dp" android:layout_height="36dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="10dp">
     <TextView android:text="LuxeParlour" android:textSize="16sp" android:textStyle="bold" android:textColor="#1E2022" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
     <TextView android:id="@+id/tagline" android:text="Customer Mobile App" android:textSize="11sp" android:textColor="#555B62" android:singleLine="true" android:ellipsize="end" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/bell_wrap" android:layout_width="40dp" android:layout_height="40dp" android:visibility="gone">
     <TextView android:id="@+id/bell" android:text="🔔" android:textSize="20sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent"/>
     <TextView android:id="@+id/bell_badge" android:text="0" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|end" android:visibility="gone"/>
    </FrameLayout>
    <Button android:id="@+id/logout_btn" android:text="Log out" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="40dp" android:visibility="gone"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/location_strip" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#F7F1E5" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical">
    <TextView android:id="@+id/location_text" android:text="📍 Deliver services near: Gulshan-1, Dhaka" android:textSize="11sp" android:textColor="#1E2022" android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/location_change" android:text="Change" android:textSize="11sp" android:textStyle="bold" android:textColor="#D64A5B" android:padding="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </LinearLayout>
   <HorizontalScrollView android:id="@+id/tab_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:visibility="gone">
    <LinearLayout android:id="@+id/tab_row" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="2dp" android:paddingBottom="6dp"/>
   </HorizontalScrollView>
  </LinearLayout>
  <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:visibility="gone" android:layout_width="match_parent" android:layout_height="3dp"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:id="@+id/content" android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
  <LinearLayout android:id="@+id/bottom_nav" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:elevation="8dp" android:padding="4dp">
   <TextView android:id="@+id/nav_home" android:text="🏠&#10;Home" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
   <TextView android:id="@+id/nav_explore" android:text="🔍&#10;Explore" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
   <TextView android:id="@+id/nav_bookings" android:text="📅&#10;Bookings" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
   <TextView android:id="@+id/nav_compare" android:text="⇄&#10;Compare" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/splash_view" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FDFBF7" android:gravity="center" android:padding="32dp">
  <ImageView android:id="@+id/splash_logo" android:src="@drawable/ic_logo" android:padding="17dp" android:contentDescription="LuxeParlour logo" android:layout_width="110dp" android:layout_height="110dp" android:elevation="6dp"/>
  <TextView android:text="LuxeParlour" android:textSize="26sp" android:textStyle="bold" android:textColor="#1E2022" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:text="Premium Salon &amp; Spa Appointments" android:textSize="13sp" android:textColor="#555B62" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <ProgressBar android:id="@+id/splash_progress" style="?android:attr/progressBarStyle" android:indeterminate="true" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="26dp"/>
  <TextView android:id="@+id/splash_msg" android:text="Loading verified salons in Dhaka..." android:textSize="12sp" android:textColor="#B53444" android:gravity="center" android:layout_marginTop="16dp" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/splash_explore" android:text="Explore Salons &amp; Book Now" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="36dp"/>
  <TextView android:id="@+id/splash_signin" android:text="Sign In" android:textSize="14sp" android:textStyle="bold" android:textColor="#6C3483" android:padding="6dp" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
</FrameLayout>
